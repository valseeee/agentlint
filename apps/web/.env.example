# Optional. Public repositories normally do not require a token.
# Only use a read-only token in a trusted local or self-hosted deployment.
GITHUB_TOKEN=github_pat_replace_me

# Private-repository access is intentionally disabled by default.
# To enable it, BOTH settings are required, and every repository must be allowlisted.
ALLOW_PRIVATE_REPOSITORIES=false
AGENTLINT_ALLOWED_REPOSITORIES=owner/private-repo,owner/another-private-repo

# Maximum remote GitHub analyses per client IP per minute. Local browser analysis is unaffected.
REMOTE_ANALYSIS_RATE_LIMIT=12
